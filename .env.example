SECRET_KEY=your_generated_secret_key_here
DEBUG=True
ALLOWED_HOSTS=*

# Comma-separated extra origins allowed to POST (e.g. https://chat.example.com). Leave empty locally.
CSRF_TRUSTED_ORIGINS=

# PostgreSQL database
DB_NAME=roomchat
DB_USER=postgres
DB_PASSWORD=''
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis channel layer (roomchat/realtime.py)
REDIS_URL=redis://127.0.0.1:6379/0