# Production environment. Copy to .env.production and fill in.
#
# On Render every one of these is supplied automatically by render.yaml — this file is
# the reference for what the app needs, and the starting point for deploying anywhere
# else. Keep .env for local development; the two are never mixed.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

DEBUG=False

# Comma-separated. On Render, leave both blank: settings.py appends the value of
# RENDER_EXTERNAL_HOSTNAME to ALLOWED_HOSTS and its https:// form to CSRF_TRUSTED_ORIGINS.
# Anywhere else, both are required — an empty ALLOWED_HOSTS makes every request 400 under
# DEBUG=False, and a missing CSRF_TRUSTED_ORIGINS rejects every POST behind a TLS proxy.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# PostgreSQL
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Redis channel layer. Required — RedisPubSubChannelLayer has no in-memory fallback.
REDIS_URL=
